---
import Arrow from './DesignArrow.astro';
const { title = "Let's see where we can help.", description = 'A brief, qualification-based Growth Review. No cost or obligation to continue.', buttonLabel = 'Book a free Growth Review' } = Astro.props;
---
<section class="audit-close"><div class="container close-inner"><div><p class="eyebrow">A place to start</p><h2>{title}</h2><p>{description}</p></div><a class="button" href="/growth-review/">{buttonLabel} <Arrow /></a></div></section>
