---
import CTA from "./CTA.astro";
const { pathway = "", title = "Find your next three growth opportunities." } =
  Astro.props;
---

<section class="audit-close">
  <div class="container audit-close-inner">
    <div>
      <p class="eyebrow">A CLEAR FIRST STEP</p><h2>{title}</h2><p>
        A no-cost, qualification-based Growth Audit. Three priorities,
        supporting observations, and a practical next step.
      </p>
    </div><div class="close-action">
      <CTA
        href={pathway ? `/growth-audit/?pathway=${pathway}` : "/growth-audit/"}
        pathway={pathway}
        location="closing"
      /><span>No account. No obligation to implement.</span>
    </div>
  </div>
</section>
