---
const { compact = false } = Astro.props;
---

<div
  class:list={["engine-visual", { compact }]}
  role="img"
  aria-label="Illustrative Growth Engine: market signals connect to intelligence, coordinated action, conversations and conversion. This is a conceptual process, not live client data."
>
  <svg
    class="system-paths"
    viewBox="0 0 600 600"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <g class="desktop-paths"
      ><path d="M145 125C240 125 225 280 306 300"></path><path
        d="M492 205C440 265 390 285 340 300"></path><path
        d="M335 355C355 420 422 430 468 495"></path><path
        class="learning-path"
        d="M463 514C196 575 60 424 106 206"></path></g
    >
    <g class="mobile-paths"
      ><path d="M116 177C217 159 225 293 325 300"></path><path
        d="M501 122C444 178 431 231 365 270"></path><path
        d="M309 341C260 383 219 420 151 473"></path><path
        class="learning-path"
        d="M141 495C31 476 9 258 80 188"></path></g
    >
  </svg>
  <span class="learning-label mono">LEARNING LOOP</span>
  <span class="path-pulse pulse-one" aria-hidden="true"></span>
  <span class="path-pulse pulse-two" aria-hidden="true"></span>
  <span class="path-pulse pulse-three" aria-hidden="true"></span>
  <div class="orbital orbital-one"></div><div class="orbital orbital-two">
  </div><div class="visual-axis"></div>
  <div class="signal-speck s1"></div><div class="signal-speck s2"></div><div
    class="signal-speck s3"
  >
  </div>
  <div class="floating-note signal-note">
    <span class="mono mini-label">01 / INPUT</span><strong
      >Signals, not guesses.</strong
    ><div class="signal-bars">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div><span class="small-note">Buyers · search · market context</span>
  </div>
  <div class="engine-core">
    <span class="core-cross" aria-hidden="true">✳</span><span class="mono"
      >ANCHORLINE</span
    ><strong>GROWTH<br />ENGINE</strong><span class="core-foot"
      >Intelligence → execution</span
    >
  </div>
  <div class="floating-note action-note">
    <span class="mono mini-label">02 / ORCHESTRATE</span><strong
      >The next right move.</strong
    ><ul>
      <li><b class="tiny-number">A</b>Identify the opportunity</li><li>
        <b class="tiny-number">B</b>Coordinate the response
      </li><li><b class="tiny-number">C</b>Improve the sales path</li>
    </ul><span class="mobile-action-summary"
      >Buyers → demand<br />Conversations → conversion</span
    >
  </div>
  <div class="floating-note outcome-note">
    <span class="mono mini-label">03 / ADVANCE</span><strong
      >More connected<br />customer acquisition.</strong
    ><span class="mobile-outcome-summary">Conversion → pipeline</span><div
      class="step-track"
    >
      <span>Attract</span><span>Engage</span><span>Convert</span>
    </div>
  </div>
  <div class="visual-caption mono">
    SYSTEM MODEL / NOT LIVE PERFORMANCE DATA
  </div>
</div>
