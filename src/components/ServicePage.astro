---
import Site from '../layouts/Site.astro';
import Arrow from './DesignArrow.astro';
import AuditClose from './AuditClose.astro';
const { service } = Astro.props;
---
<Site title={`${service.title} | Anchorline Systems`} description={service.short} serviceName={service.title} serviceType={service.title}>
  <section class="container page-intro"><a class="breadcrumb mono" href="/services/">Services / {service.number}</a><h1>{service.title}.</h1><p class="lede">{service.intro}</p><a class="button" href={`/contact/?interest=${service.slug}`}>Discuss your project <Arrow /></a></section>
  <section class="container section two-col"><div><p class="eyebrow">The scope</p><h2>What the work<br />can include.</h2></div><div><ul class="ruled-list">{service.includes.map(item => <li>{item}</li>)}</ul><p class="boundary">{service.boundaries}</p></div></section>
  <section class="service-band"><div class="container section two-col"><div><p class="eyebrow">How it's priced</p><h2>{service.model}.</h2></div><div><p class="lede">{service.modelText}</p><a class="text-link" href="/pricing/">See engagement options <Arrow /></a></div></div></section>
  <AuditClose />
</Site>
