---
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/redesign.css";
import Brand from "../components/Brand.astro";
import Arrow from "../components/DesignArrow.astro";
const {
  title = 'Anchorline Systems',
  ogTitle = title,
  description = 'Website development, search visibility, lead generation, and website care from Anchorline Systems.',
  page = "home",
  canonicalPath = Astro.url.pathname === '/growth-engine/' ? '/services/' : Astro.url.pathname,
  forceNoindex = false,
  schemaType = "WebPage",
  ogType = "website",
  serviceName,
  serviceType,
  serviceAudience,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  socialImage = "/brand/social.png",
  socialImageWidth = 1200,
  socialImageHeight = 630,
} = Astro.props;
const isProduction = process.env.CONTEXT === "production";
const publicOrigin = "https://anchorlineai.com";
const isPublicProduction = isProduction && process.env.URL === publicOrigin;
const previewOrigin = process.env.DEPLOY_PRIME_URL || "http://localhost:4321";
const siteOrigin = isProduction ? publicOrigin : previewOrigin;
const canonical = new URL(canonicalPath, siteOrigin).href;
const robots =
  forceNoindex || !isProduction
    ? "noindex, nofollow, noarchive"
    : "index, follow";
const showPreviewChrome = !isProduction;
const organization = {
  "@type": "Organization",
  "@id": "https://anchorlineai.com/#organization",
  name: "Anchorline Systems LLC",
  url: "https://anchorlineai.com",
  logo: {
    "@type": "ImageObject",
    url: "https://anchorlineai.com/brand/mark.webp",
    contentUrl: "https://anchorlineai.com/brand/mark.webp",
    width: 96,
    height: 96,
  },
};
const webSite = {
  "@type": "WebSite",
  "@id": "https://anchorlineai.com/#website",
  name: "Anchorline Systems",
  url: "https://anchorlineai.com",
  publisher: { "@id": organization["@id"] },
};
const webPage = {
  "@type": schemaType,
  "@id": `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  isPartOf: { "@id": webSite["@id"] },
  about: { "@id": organization["@id"] },
};
const service = serviceName
  ? {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: serviceName,
      description,
      url: canonical,
      serviceType,
      provider: { "@id": organization["@id"] },
      ...(serviceAudience
        ? { audience: { "@type": "Audience", audienceType: serviceAudience } }
        : {}),
    }
  : null;
const schema = {
  "@context": "https://schema.org",
  "@graph": [organization, webSite, webPage, ...(service ? [service] : [])],
};
const path = Astro.url.pathname;
const links = [["/services/", "Services"], ["/approach/", "Approach"], ["/insights/", "Insights"], ["/pricing/", "Pricing"]];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/mark.webp" type="image/webp" />
    <meta property="og:title" content={ogTitle} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content={ogType} /><meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:image"
      content={new URL(socialImage, siteOrigin).href}
    />
    <meta property="og:image:width" content={socialImageWidth} /><meta
      property="og:image:height"
      content={socialImageHeight}
    />
    {
      ogType === "article" && (
        <>
          <meta
            property="article:published_time"
            content={articlePublishedTime}
          />
          {articleModifiedTime && (
            <meta
              property="article:modified_time"
              content={articleModifiedTime}
            />
          )}
          <meta property="article:author" content={articleAuthor} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(socialImage, siteOrigin).href}
    />
    {
      isPublicProduction && (
        <>
          <script
            is:inline
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-KPQ0G7C2YY"
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-KPQ0G7C2YY');`}
          />
        </>
      )
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main">Skip to content</a>
    {showPreviewChrome && <div class="preview-strip"><div class="container"><span><i aria-hidden="true"></i> Release preview</span><span>Not production</span></div></div>}
    <header class="site-header container">
      <Brand />
      <nav class="desktop-nav" aria-label="Main navigation">{links.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <a class="button header-contact" href="/contact/">Get in touch <Arrow /></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation"><span class="menu-lines" aria-hidden="true"></span></button>
      <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {links.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}<Arrow /></a>)}
        <a href="/about/">About Anchorline <Arrow /></a><a href="/contact/">Get in touch <Arrow /></a>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer">
      <div class="container footer-top"><div><Brand /><p>Websites, search &amp; lead generation.</p></div><nav aria-label="Footer navigation"><a href="/services/">Services</a><a href="/pricing/">Pricing</a><a href="/about/">About</a><a href="/insights/">Insights</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav></div>
      <div class="container footer-bottom"><span>&copy; 2026 Anchorline Systems LLC</span><a href="https://amg.anchorlineai.com" target="_blank" rel="noopener noreferrer">Client Login <Arrow /></a>{showPreviewChrome && <span>Release preview / not production</span>}</div>
    </footer>
    <script>import "../scripts/site.js";</script>
  </body>
</html>
