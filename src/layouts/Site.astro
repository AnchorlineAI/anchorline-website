---
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import "../styles/refinement.css";
import "../styles/launch-completion.css";
import "../styles/reconstruction.css";
import "../styles/release.css";
import CTA from "../components/CTA.astro";
const {
  title,
  description,
  page = "home",
  canonicalPath = Astro.url.pathname,
  forceNoindex = false,
  schemaType = "WebPage",
  ogType = "website",
  serviceName,
  serviceType,
  serviceAudience,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;
const isProduction = process.env.CONTEXT === "production";
const publicOrigin = "https://anchorlineai.com";
const previewOrigin = process.env.DEPLOY_PRIME_URL || "http://localhost:4321";
const siteOrigin = isProduction ? publicOrigin : previewOrigin;
const canonical = new URL(canonicalPath, siteOrigin).href;
const robots =
  forceNoindex || !isProduction
    ? "noindex, nofollow, noarchive"
    : "index, follow";
const showPreviewChrome = !isProduction;
const organization = {
  "@type": "Organization",
  "@id": "https://anchorlineai.com/#organization",
  name: "Anchorline Systems LLC",
  url: "https://anchorlineai.com",
  logo: "https://anchorlineai.com/Anchorline_Logo.PNG",
};
const webSite = {
  "@type": "WebSite",
  "@id": "https://anchorlineai.com/#website",
  name: "Anchorline Systems",
  url: "https://anchorlineai.com",
  publisher: { "@id": organization["@id"] },
};
const webPage = {
  "@type": schemaType,
  "@id": `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  isPartOf: { "@id": webSite["@id"] },
  about: { "@id": organization["@id"] },
};
const service = serviceName
  ? {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: serviceName,
      description,
      url: canonical,
      serviceType,
      provider: { "@id": organization["@id"] },
      ...(serviceAudience
        ? { audience: { "@type": "Audience", audienceType: serviceAudience } }
        : {}),
    }
  : null;
const schema = {
  "@context": "https://schema.org",
  "@graph": [organization, webSite, webPage, ...(service ? [service] : [])],
};
const links = [
  ["/growth-engine/", "The Growth Engine", "engine"],
  ["/growth-engine/b2b/", "B2B Growth", "b2b"],
  ["/growth-engine/local/", "Local Growth", "local"],
  ["/approach/", "Our Approach", "approach"],
  ["/about/", "About", "about"],
  ["/insights/", "Insights", "insights"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/mark.webp" type="image/webp" />
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    />
    <meta property="og:type" content={ogType} /><meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:image"
      content={new URL("/brand/social.png", siteOrigin).href}
    />
    <meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    />
    {
      ogType === "article" && (
        <>
          <meta
            property="article:published_time"
            content={articlePublishedTime}
          />
          {articleModifiedTime && (
            <meta
              property="article:modified_time"
              content={articleModifiedTime}
            />
          )}
          <meta property="article:author" content={articleAuthor} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/brand/social.png", siteOrigin).href}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body data-page={page}>
    <a href="#main" class="skip-link">Skip to content</a>
    {
      showPreviewChrome && (
        <div class="preview-bar">
          <span class="preview-dot" aria-hidden="true" /> Deploy Preview{" "}
          <span class="preview-detail">— not production</span>
        </div>
      )
    }
    <header class="site-header">
      <div class="nav-wrap">
        <a class="wordmark" href="/" aria-label="Anchorline Systems home"
          ><img src="/brand/mark.webp" width="36" height="36" alt="" /><span
            >ANCHORLINE<small>SYSTEMS</small></span
          ></a
        >
        <nav class="desktop-nav" aria-label="Main navigation">
          {
            links.map(([href, text, key]) => (
              <a href={href} aria-current={page === key ? "page" : undefined}>
                {text}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <CTA location="header" /><a
            class="mobile-audit-link"
            href="/growth-audit/"
            data-cta="audit"
            data-location="header"
            aria-label="Request Your Growth Audit"
            >Growth Audit <span aria-hidden="true">↗</span></a
          ><button
            class="menu-toggle"
            aria-label="Open navigation"
            aria-expanded="false"
            aria-controls="mobile-navigation"><span></span><span></span></button
          >
        </div>
      </div>
      <nav
        id="mobile-navigation"
        class="mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        {
          links.map(([href, text, key]) => (
            <a href={href} aria-current={page === key ? "page" : undefined}>
              {text}
            </a>
          ))
        }<a href="/growth-audit/" data-cta="audit" data-location="mobile-menu"
          >Request Your Growth Audit</a
        >
      </nav>
    </header>
    {
      !["audit", "receipt", "404"].includes(page) && (
        <div class="r-atmosphere" aria-hidden="true">
          {Array.from({ length: 14 }, (_, i) => (
            <i
              style={`--i:${i};--x:${[12, 83, 6, 92, 38, 71, 17, 88, 4, 77, 29, 94, 8, 65][i]}%;--y:${3 + i * 6.8}%`}
            />
          ))}
        </div>
      )
    }
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="wordmark" href="/"
            >ANCHORLINE<span class="sr-only"> home</span></a
          ><p>
            We build the systems that help<br />good organizations grow.
          </p>
        </div><div class="footer-nav">
          <a href="/growth-engine/">The Growth Engine</a><a
            href="/growth-engine/b2b/">B2B Growth</a
          ><a href="/growth-engine/local/">Local Growth</a><a href="/approach/"
            >Our Approach</a
          ><a href="/about/">About Anchorline</a><a href="/insights/"
            >Insights</a
          ><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a
            href="/growth-audit/"
            data-cta="audit"
            data-location="footer">Request Your Growth Audit</a
          >
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 Anchorline Systems LLC · Pennsylvania</span><a
          href="https://amg.anchorlineai.com"
          target="_blank"
          rel="noopener noreferrer"
          >Client Login <span aria-hidden="true">↗</span></a
        >{
          showPreviewChrome && (
            <span class="preview-footer">Deploy Preview · not production</span>
          )
        }
      </div>
    </footer>
    {
      !["audit", "receipt", "404"].includes(page) && (
        <div class="r-motion-control">
          <button type="button" data-motion-toggle aria-pressed="false">
            Pause page motion
          </button>
        </div>
      )
    }
    <script>
      import "../scripts/discovery-motion.js";
      import "../scripts/site.js";
    </script>
  </body>
</html>
