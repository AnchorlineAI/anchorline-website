---
import Site from '../layouts/Site.astro';
import AuditClose from '../components/AuditClose.astro';
---
<Site page="about" schemaType="AboutPage" description="Meet Kris McFadden and learn how Anchorline approaches website development, search visibility, lead generation, and ongoing website care." title="About Anchorline Systems"><section class="container page-intro"><p class="eyebrow">About Anchorline</p><h1>Founder-led.<br />Close to the work.</h1><p class="lede">Anchorline Systems helps businesses improve their websites, search visibility, and lead-generation efforts with clearly scoped, practical work.</p></section><section class="container section founder"><img src="/kris-mcfadden.webp" alt="Kris McFadden, founder of Anchorline Systems" width="600" height="601" /><div><p class="eyebrow">Founder & CEO</p><h2 id="kris-mcfadden">Kris McFadden</h2><p>Kris leads Anchorline's work from the first conversation through the decisions that shape a project.</p><p>AI and research tools help with the work. Human judgment, review, and accountability remain part of delivery.</p><p>Our current focus is website development, SEO and AI-search visibility, focused lead generation, and website care.</p></div></section><AuditClose />  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://anchorlineai.com/about/#kris-mcfadden",
      name: "Kris McFadden",
      jobTitle: "Founder and CEO",
      honorificSuffix: "MBA",
      hasCredential: {
        "@type": "EducationalOccupationalCredential",
        credentialCategory: "degree",
        name: "MBA in Healthcare Management",
      },
      sameAs: [
        "https://krismcfadden.com",
        "https://www.linkedin.com/in/krismcfadden/",
      ],
      worksFor: {
        "@id": "https://anchorlineai.com/#organization",
      },
      url: "https://anchorlineai.com/about/",
      image: "https://anchorlineai.com/kris-mcfadden.webp",
    }).replace(/</g, "\\u003c")}
  />
</Site>
