---
import Site from '../layouts/Site.astro';
import AuditClose from '../components/AuditClose.astro';
---
<Site description="How Anchorline scopes website and search work, reviews delivery, and separates initial research from implementation and ongoing support." title="Our Approach | Anchorline Systems"><section class="container page-intro"><p class="eyebrow">How we work</p><h1>Clear decisions.<br />Then useful work.</h1><p class="lede">You don't need a bigger package just because a provider sells one. We start with the problem and agree on the work needed to address it.</p></section><section class="container section process-list">{[['01','Talk about the need',"We learn what your business does, who you're trying to reach, and what isn't working."],['02','Establish the scope',"If we need more evidence, there's a paid audit. If the need is already clear, we can quote the work directly."],['03','Build and review','The agreed scope defines deliverables, responsibilities, revision rounds, and the fee. You review the work before release.'],['04','Check and improve',"We test what we've built. Ongoing search and website care are separate engagements when they're useful."]].map(([n,title,copy]) => <article><span class="mono">{n}</span><h2>{title}</h2><p>{copy}</p></article>)}</section><AuditClose /></Site>
