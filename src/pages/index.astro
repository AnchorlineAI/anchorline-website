---
import Site from '../layouts/Site.astro';
import Arrow from '../components/DesignArrow.astro';
import CompanyClose from '../components/CompanyClose.astro';
import { services } from '../data';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import halftone from '../../public/brand/halftone-anchor.png';
const articles = await getCollection('insights');
const feature = articles.find(a => a.id === 'growth-audit-website-search-lead-generation') ?? articles.find(a => a.data.featured) ?? articles[0];
---
<Site title="Anchorline Systems | Digital Services, Commerce & Data Partnerships" description="We provide digital services, operate an online retail business, and help companies explore data-licensing opportunities.">
  <section class="hero container company-hero">
    <div class="hero-art" aria-hidden="true"><Image src={halftone} width={800} quality={85} format="webp" fetchpriority="high" loading="eager" alt="" /></div>
    <div class="hero-copy"><h1>Anchorline<br />Systems</h1><p class="hero-description">We provide digital services, operate an online retail business, and help companies explore data-licensing opportunities.</p><div class="actions"><a class="button" href="#our-work">Explore our work <Arrow /></a><a class="text-link" href="#conversation">Get in touch <Arrow /></a></div></div>
    <div class="hero-caption mono"><span>Founder-led.</span><span>Anchorline Systems LLC</span></div>
  </section>
  <section class="service-band" id="our-work"><div class="container section company-services"><div class="company-introduction"><p class="eyebrow">Digital services</p><h2>Websites, search &amp;<br />lead generation.</h2><p>We build websites, improve search visibility, and help businesses turn interest into conversations.</p><a class="button" href="/services/">Explore services <Arrow /></a></div><div class="service-list">{services.map(s => <a href={`/services/${s.slug}/`}><span class="mono">{s.number}</span><div><h3>{s.title}</h3><p>{s.short}</p></div><Arrow /></a>)}</div></div></section>
  <section class="container section company-area"><p class="eyebrow">Commerce</p><h2>Marketplace retail.</h2><p>We operate a marketplace retail business and welcome relationships with manufacturers and authorized distributors.</p><a class="text-link" href="/commerce/">Explore commerce <Arrow /></a></section>
  <section class="service-band"><div class="container section company-partnerships"><div class="company-area"><p class="eyebrow">Data partnerships</p><h2>Your business knowledge may have value beyond your business.</h2><p>We help business owners explore whether their company-created documentation could fit an AI data-licensing opportunity.</p><a class="text-link" href="/data-partnerships/">Explore data partnerships <Arrow /></a></div><p class="company-aside">Independent introductions.<br />Shared only with your permission.</p></div></section>
  {feature && <section class="container section feature"><div><p class="eyebrow">Featured insight</p><h2>{feature.data.title}</h2><p>{feature.data.description}</p><a class="text-link" href={`/insights/${feature.id}/`}>Read the article <Arrow /></a></div>{feature.data.image && <img src={feature.data.image} alt={feature.data.imageAlt ?? ''} width="800" height="450" loading="lazy" />}</section>}
  <CompanyClose />
</Site>
