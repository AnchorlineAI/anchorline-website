---
import Site from '../layouts/Site.astro';
import Arrow from '../components/DesignArrow.astro';
import AuditClose from '../components/AuditClose.astro';
import { services } from '../data';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import halftone from '../../public/brand/halftone-anchor.png';
const articles = await getCollection('insights');
const feature = articles.find(a => a.id === 'growth-audit-website-search-lead-generation') ?? articles.find(a => a.data.featured) ?? articles[0];
---
<Site title="Websites, Search & Lead Generation | Anchorline Systems">
  <section class="hero container">
    <div class="hero-art" aria-hidden="true"><Image src={halftone} width={800} quality={85} format="webp" fetchpriority="high" loading="eager" alt="" /></div>
    <div class="hero-copy"><h1>Website development,<br />search & lead<br />generation.</h1><p class="hero-description">We build websites, improve search visibility, and help businesses turn interest into conversations.</p><div class="actions"><a class="button" href="/growth-review/">Book a Growth Review <Arrow /></a><a class="text-link" href="/services/">Explore services <Arrow /></a></div></div>
    <div class="hero-caption mono"><span>Founder-led. Clearly scoped.</span><span>01 / Website & growth partner</span></div>
  </section>
  <section class="service-band"><div class="container section"><div class="section-heading"><p class="eyebrow">What we do</p><h2>The work your<br />website needs.</h2></div><div class="service-list">{services.map(s => <a href={`/services/${s.slug}/`}><span class="mono">{s.number}</span><div><h3>{s.title}</h3><p>{s.short}</p></div><Arrow /></a>)}</div></div></section>
  <section class="container section approach-teaser"><p class="eyebrow">How we work</p><div><h2>Understand the need.<br />Agree on the work.<br />Then build.</h2><p>Sometimes the next step is obvious. Sometimes it takes a closer review. We'll be clear about what we recommend, what's included, and what it costs before the work starts.</p><a class="text-link" href="/approach/">Our approach <Arrow /></a></div></section>
  {feature && <section class="container section feature"><div><p class="eyebrow">Featured insight</p><h2>{feature.data.title}</h2><p>{feature.data.description}</p><a class="text-link" href={`/insights/${feature.id}/`}>Read the article <Arrow /></a></div>{feature.data.image && <img src={feature.data.image} alt={feature.data.imageAlt ?? ''} width="800" height="450" loading="lazy" />}</section>}
  <AuditClose description="Tell us what you're trying to improve. We'll take a look and see where we can help." buttonLabel="Book a Growth Review" />
</Site>
