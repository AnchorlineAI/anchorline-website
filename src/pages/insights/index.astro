---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Arrow from '../../components/DesignArrow.astro';
const articles = (await getCollection('insights')).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const feature = articles.find(a => a.id === 'growth-audit-website-search-lead-generation') ?? articles.find(a => a.data.featured) ?? articles[0];
const rest = articles.filter(a => a.id !== feature?.id);
const categories = [...new Set(articles.map(a => a.data.category))].sort();
---
<Site description="Anchorline articles on websites, search visibility, AI tools, and practical business growth." title="Insights | Anchorline Systems"><section class="container page-intro"><p class="eyebrow">Anchorline insights</p><h1>A closer look<br />at the work.</h1><p class="lede">Perspectives on websites, search, and the tools changing how businesses reach their customers.</p></section>
{feature && <section class="container section feature"><div><p class="eyebrow">Featured insight / {feature.data.category}</p><h2><a href={`/insights/${feature.id}/`}>{feature.data.title}</a></h2><p>{feature.data.description}</p><a class="text-link" href={`/insights/${feature.id}/`}>Read the article <Arrow /></a></div>{feature.data.image && <img src={feature.data.image} alt={feature.data.imageAlt ?? ''} width="800" height="450" />}</section>}
<section class="container section"><div class="insights-controls"><h2>Latest articles</h2><div><label class="mono" for="category">Topic</label><select id="category"><option value="all">All topics</option>{categories.map(c => <option value={c}>{c}</option>)}</select></div></div><p id="article-count" class="mono" aria-live="polite">{rest.length} articles</p><div class="insights-grid">{rest.map(a => <article class="insight-card" data-category={a.data.category}>{a.data.image && <a href={`/insights/${a.id}/`} tabindex="-1" aria-hidden="true"><img src={a.data.image} alt="" width="800" height="450" loading="lazy" /></a>}<p class="eyebrow">{a.data.category}</p><h3><a href={`/insights/${a.id}/`}>{a.data.title}</a></h3><p>{a.data.description}</p><a class="text-link" href={`/insights/${a.id}/`}>Read article <Arrow /></a></article>)}</div><p id="empty-topics" hidden>No additional articles in this topic. The featured article stays pinned above.</p></section></Site>
<script>
  document.querySelector<HTMLSelectElement>('#category')?.addEventListener('change', (event) => {
    const value = (event.target as HTMLSelectElement).value;
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.insight-card').forEach(card => { card.hidden = value !== 'all' && card.dataset.category !== value; if (!card.hidden) visible++; });
    const count = document.querySelector('#article-count');
    if (count) count.textContent = `${visible} article${visible === 1 ? '' : 's'}`;
    const empty = document.querySelector<HTMLElement>('#empty-topics');
    if (empty) empty.hidden = visible !== 0;
  });
</script>
