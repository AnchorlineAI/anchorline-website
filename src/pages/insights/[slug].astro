---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Site from "../../layouts/Site.astro";
import AuditClose from "../../components/AuditClose.astro";

export async function getStaticPaths() {
  const articles = await getCollection("insights");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"insights">;
}

const { article } = Astro.props;
const { Content } = await render(article);
const canonicalPath = `/insights/${article.id}/`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);
const related = (await getCollection("insights"))
  .filter((entry) => entry.id !== article.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `https://anchorlineai.com${canonicalPath}#article`,
      headline: article.data.title,
      description: article.data.description,
      datePublished: article.data.publishDate.toISOString(),
      ...(article.data.updatedDate
        ? { dateModified: article.data.updatedDate.toISOString() }
        : {}),
      image: "https://anchorlineai.com/brand/social.png",
      author: {
        "@type": "Person",
        "@id": "https://anchorlineai.com/about/#kris-mcfadden",
        name: article.data.author,
        url: "https://anchorlineai.com/about/",
      },
      publisher: { "@id": "https://anchorlineai.com/#organization" },
      mainEntityOfPage: {
        "@id": `https://anchorlineai.com${canonicalPath}#webpage`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://anchorlineai.com${canonicalPath}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://anchorlineai.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Insights",
          item: "https://anchorlineai.com/insights/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: article.data.title,
          item: `https://anchorlineai.com${canonicalPath}`,
        },
      ],
    },
  ],
};
---

<Site
  page="insights"
  title={`${article.data.title} | Anchorline Insights`}
  description={article.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  articlePublishedTime={article.data.publishDate.toISOString()}
  articleModifiedTime={article.data.updatedDate?.toISOString()}
  articleAuthor={article.data.author}
>
  <article class="container insight-article">
    <header class="insight-article-header">
      <nav class="article-breadcrumb mono" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a
          href="/insights/">Insights</a
        >
      </nav>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="r-lede">{article.data.description}</p>
      <div class="article-byline">
        <span>By <a href="/about/">{article.data.author}</a></span>
        <time datetime={article.data.publishDate.toISOString()}>
          {formatDate(article.data.publishDate)}
        </time>
      </div>
    </header>
    <div class="article-layout">
      <aside class="article-rail" aria-label="Article context">
        <span class="mono">ANCHORLINE INSIGHTS</span>
        <p>Systems thinking for practical growth decisions.</p>
      </aside>
      <div class="article-prose"><Content /></div>
    </div>
  </article>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema).replace(/</g, "\\u003c")}
  />
  <aside class="container related-insights" aria-labelledby="related-title">
    <p class="eyebrow">CONTINUE READING</p>
    <h2 id="related-title">Related Insights</h2>
    <div>
      {
        related.map((entry) => (
          <a href={`/insights/${entry.id}/`}>
            <span class="mono">{entry.data.category}</span>
            <strong>{entry.data.title}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </aside>
  <AuditClose title="Turn insight into a clearer next step." />
</Site>
