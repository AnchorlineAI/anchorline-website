{
  "name": "anchorline-growth-engine-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && astro dev --host 0.0.0.0",
    "build": "node scripts/guard.mjs && node scripts/prepare-static-context.mjs && node scripts/prepare-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-output.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "node --test tests/diagnostics.test.mjs"
  },
  "dependencies": {
    "astro": "7.3.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0"
  }
}
